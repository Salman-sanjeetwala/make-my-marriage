{
  "name": "make-my-marriage",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace @mmm/web",
    "dev:api": "npm run dev --workspace @mmm/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "eslint": "10.15.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
